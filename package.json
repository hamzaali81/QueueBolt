{
  "name": "queuebolt",
  "version": "1.0.0",
  "description": "A lightweight, reliable background job queue for Node.js with retries, scheduling, dead-letter queues, and pluggable storage backends.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./backends/redis": {
      "types": "./dist/backends/redis.d.ts",
      "import": "./dist/backends/redis.mjs",
      "require": "./dist/backends/redis.js"
    },
    "./backends/sqlite": {
      "types": "./dist/backends/sqlite.d.ts",
      "import": "./dist/backends/sqlite.mjs",
      "require": "./dist/backends/sqlite.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "release": "npm run build && changeset publish"
  },
  "keywords": [
    "queue",
    "job",
    "task",
    "worker",
    "background",
    "async",
    "retry",
    "scheduler",
    "dead-letter-queue",
    "redis",
    "sqlite",
    "typescript",
    "nodejs"
  ],
  "author": "Hamza Ali <hamzaali81811@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hamzaali81/queuebolt.git"
  },
  "bugs": {
    "url": "https://github.com/hamzaali81/queuebolt/issues"
  },
  "homepage": "https://github.com/hamzaali81/queuebolt#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "peerDependencies": {
    "ioredis": ">=5.0.0",
    "better-sqlite3": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    }
  }
}
